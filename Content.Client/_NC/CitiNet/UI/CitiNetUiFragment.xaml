<BoxContainer xmlns="https://spacestation14.io"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              x:Class="Content.Client._NC.CitiNet.UI.CitiNetUiFragment"
              Orientation="Vertical"
              HorizontalExpand="True"
              VerticalExpand="True"
              Margin="4">

    <PanelContainer StyleClasses="NightCityPhoneShell" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="8">
            <PanelContainer StyleClasses="NightCityPhoneStatusBar" Margin="0 0 0 8">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8 4 8 4">
                    <Label Text="{Loc 'citinet-ui-app-name'}" StyleClasses="NightCityGlowText" />
                    <Label Name="ScreenTitleLabel" Text="{Loc 'citinet-ui-screen-chats'}" StyleClasses="NightCitySecondaryText" Margin="8 0 0 0" />
                    <Label Name="ScreenSubtitleLabel" Text="" StyleClasses="NightCityMutedText" Margin="8 0 0 0" />
                    <Control HorizontalExpand="True" />
                    <RichTextLabel Name="NetworkStatusLabel" VerticalAlignment="Center" />
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
                <PanelContainer Name="ListPanel" StyleClasses="NightCityPhoneListPanel" MinWidth="250" Margin="0 0 8 0" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="8">
                        <BoxContainer Orientation="Vertical" Margin="0 0 0 8">
                            <RichTextLabel Name="HeaderLabel" Margin="0 0 0 3" />
                            <Label Name="ListTitleLabel" Text="{Loc 'citinet-ui-list-chat-rooms'}" StyleClasses="NightCityGlowText" Margin="0 0 0 2" />
                            <Label Name="ListSubtitleLabel" Text="{Loc 'citinet-ui-subtitle-available-networks'}" StyleClasses="NightCityMutedText" />
                        </BoxContainer>

                        <PanelContainer StyleClasses="NightCityPhoneInset" VerticalExpand="True">
                            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                                <BoxContainer Name="ListContainer" Orientation="Vertical" Margin="8" />
                            </ScrollContainer>
                        </PanelContainer>
                    </BoxContainer>
                </PanelContainer>

                <PanelContainer Name="DetailPanel" StyleClasses="NightCityPhoneDetailPanel" HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="8">
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 8">
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                <RichTextLabel Name="ContentHeaderLabel" Margin="0 0 0 3" />
                                <RichTextLabel Name="ContentSubHeaderLabel" />
                            </BoxContainer>
                            <BoxContainer Orientation="Vertical" HorizontalAlignment="Right">
                                <RichTextLabel Name="UsernameLabel" HorizontalAlignment="Right" />
                                <RichTextLabel Name="OnlineStatusLabel" HorizontalAlignment="Right" Margin="0 3 0 0" />
                            </BoxContainer>
                        </BoxContainer>

                        <PanelContainer Name="PasswordPanel" StyleClasses="NightCityPhoneActionCard" Visible="False" Margin="0 0 0 8">
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8">
                                <LineEdit Name="PasswordInput" HorizontalExpand="True" PlaceHolder="{Loc 'citinet-ui-placeholder-enter-access-code'}" StyleClasses="NightCityInput" />
                                <Button Name="PasswordSubmitBtn" Text="{Loc 'citinet-ui-action-unlock'}" StyleClasses="NightCityButton" Margin="6 0 0 0" />
                            </BoxContainer>
                        </PanelContainer>

                        <PanelContainer Name="ActionControlsPanel" StyleClasses="NightCityPhoneActionCard" Visible="False" Margin="0 0 0 8">
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8">
                                <LineEdit Name="ActionInput" HorizontalExpand="True" PlaceHolder="..." StyleClasses="NightCityInput" />
                                <Button Name="ActionButton" Text="{Loc 'citinet-ui-action-execute'}" StyleClasses="NightCityButton" Margin="6 0 0 0" />
                            </BoxContainer>
                        </PanelContainer>

                        <PanelContainer Name="CallControlsPanel" StyleClasses="NightCityPhoneCallCard" Visible="False" Margin="0 0 0 8">
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="8">
                                <RichTextLabel Name="CallControlsStatusLabel" Margin="0 0 0 6" />
                                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                                    <Button Name="CallDialButton" Text="{Loc 'citinet-ui-action-dial'}" StyleClasses="NightCityButton" Visible="False" />
                                    <Button Name="CallAcceptButton" Text="{Loc 'citinet-ui-action-accept'}" StyleClasses="NightCityButton" Visible="False" Margin="4 0 0 0" />
                                    <Button Name="CallDeclineButton" Text="{Loc 'citinet-ui-action-decline'}" StyleClasses="NightCityButtonDanger" Visible="False" Margin="4 0 0 0" />
                                    <Button Name="CallJoinVoiceButton" Text="{Loc 'citinet-ui-action-join-voice'}" StyleClasses="NightCityButton" Visible="False" Margin="4 0 0 0" />
                                    <Button Name="CallLeaveVoiceButton" Text="{Loc 'citinet-ui-action-leave-voice'}" StyleClasses="NightCityButtonDanger" Visible="False" Margin="4 0 0 0" />
                                    <Button Name="CallPingLocationButton" Text="{Loc 'citinet-ui-action-ping'}" StyleClasses="NightCityButtonGhost" Margin="4 0 0 0" />
                                    <Button Name="CallHangUpButton" Text="{Loc 'citinet-ui-action-hang-up'}" StyleClasses="NightCityButtonDanger" Visible="False" Margin="4 0 0 0" />
                                </BoxContainer>
                            </BoxContainer>
                        </PanelContainer>

                        <PanelContainer StyleClasses="NightCityPhoneInset" VerticalExpand="True" Margin="0 0 0 8">
                            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                                <BoxContainer Name="ContentMessagesContainer" Orientation="Vertical" Margin="8" />
                            </ScrollContainer>
                        </PanelContainer>

                        <PanelContainer Name="ChatInputPanel" StyleClasses="NightCityPhoneComposer">
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8">
                                <LineEdit Name="ChatInput" HorizontalExpand="True" PlaceHolder="{Loc 'citinet-ui-placeholder-transmit-message'}" StyleClasses="NightCityInput" />
                                <Button Name="ChatSendButton" Text="{Loc 'citinet-ui-action-send'}" StyleClasses="NightCityButton" Margin="6 0 0 0" />
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>

            <PanelContainer StyleClasses="NightCityPhoneNavBar" Margin="0 8 0 0">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8 6 8 6">
                    <Button Name="MenuDirectCallsBtn" Text="{Loc 'citinet-ui-screen-calls'}" HorizontalExpand="True" StyleClasses="NightCityTabButton" />
                    <Button Name="MenuChatRoomsBtn" Text="{Loc 'citinet-ui-screen-chats'}" HorizontalExpand="True" StyleClasses="NightCityTabButton" Margin="6 0 0 0" />
                    <Button Name="MenuDataPoolBtn" Text="{Loc 'citinet-ui-screen-pool'}" HorizontalExpand="True" StyleClasses="NightCityTabButton" Margin="6 0 0 0" />
                    <Button Name="MenuContactsBtn" Text="{Loc 'citinet-ui-screen-contacts'}" HorizontalExpand="True" StyleClasses="NightCityTabButton" Margin="6 0 0 0" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
